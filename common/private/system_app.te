# Allow Settings to read custom legal URL
get_prop(system_app, legal_url_prop)

# Allow Settings/LineageParts to read custom version
get_prop(system_app, custom_version_prop)

# Allow Settings to read ro.vendor.build.security_patch
get_prop(system_app, vendor_security_patch_level_prop)

# Allow access to the HALs
hal_client_domain(system_app, hal_lineage_livedisplay)
hal_client_domain(system_app, hal_lineage_touch)

# Allow SetupWizard to set recovery update prop
set_prop(system_app, recovery_update_prop)

allow system_app proc_vendor_sched:dir rw_dir_perms;
allow system_app proc_vendor_sched:file rw_file_perms;

# TrickyStore - AxionParts
allow system_app adb_data_file:dir { search getattr };
allow system_app trickystore_data_file:dir { create open read write add_name remove_name search getattr };
allow system_app trickystore_data_file:file { create open read write getattr setattr unlink };

# PlayIntegrityFix - AxionParts
allow system_app pif_data_file:dir { create open read write add_name remove_name search getattr };
allow system_app pif_data_file:file { create open read write getattr setattr unlink };
