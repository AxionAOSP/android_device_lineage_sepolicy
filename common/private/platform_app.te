# Allow NFC service to be found
allow platform_app nfc_service:service_manager find;
allow platform_app fwk_vibrator_control_service:service_manager find;

# Allow LiveDisplay HAL service to be found
hal_client_domain(platform_app, hal_lineage_livedisplay)

# Allow PowerShare HAL service to be found
hal_client_domain(platform_app, hal_lineage_powershare)

get_prop(platform_app, usb_uvc_enabled_prop)

get_prop(platform_app, bluetooth_lea_prop)
allow platform_app ax_sandbox_service:service_manager find;
allow platform_app ax_sandbox_vault_file:dir create_dir_perms;
allow platform_app ax_sandbox_vault_file:file create_file_perms;
allow platform_app system_data_file:dir search;
allow platform_app system_userdir_file:dir search;
